    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "dependencies": {
    "@om-code/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

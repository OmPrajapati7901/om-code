{
  "name": "@om-code/context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central runtime bounding: result truncation with blob spill, and run budgets",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
